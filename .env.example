# Atlas Signal runs without any environment variables, paid API keys or DB.
# Copy to .env.local for a local Next.js/CLI run. Never commit real credentials.

# Optional PostgreSQL + PostGIS persistence.
# Start PostgreSQL, uncomment this connection, then run `npm run db:migrate`.
# DATABASE_URL=postgresql://atlas:atlas-local-only@localhost:5432/atlas_signal

# Optional ReliefWeb reports; use an appname approved by ReliefWeb.
# No made-up/default appname is sent. Blank disables this provider.
RELIEFWEB_APPNAME=

# Default hazard feeds; set either to false to disable.
USGS_ENABLED=true
GDACS_ENABLED=true

# Live news feeds are enabled by default. RSS_ENABLED=false disables all RSS.
# Older copies of this file used RSS_ENABLED=false; update that value to enable
# the new news defaults. Review each publisher's terms before public/commercial use.
RSS_ENABLED=true
BBC_ENABLED=true
DW_ENABLED=true
UN_NEWS_ENABLED=true
GLOBAL_VOICES_ENABLED=true

# Optional feeds. Enabling a flag does not grant source redistribution rights.
GDELT_ENABLED=false
FRANCE24_ENABLED=false
ALJAZEERA_ENABLED=false

# Standalone ingestion CLI interval; 60 to 86400 seconds.
INGEST_INTERVAL_SECONDS=300

# Docker Compose settings. Compose reads `.env`, not `.env.local`.
# The default database password is for loopback-only local development.
PORT=3000
POSTGRES_PORT=5432
POSTGRES_PASSWORD=atlas-local-only

# Uncomment for the web container to use the optional db service.
# Docker containers address PostgreSQL as "db", not "localhost".
# DOCKER_DATABASE_URL=postgresql://atlas:atlas-local-only@db:5432/atlas_signal

# There are deliberately no NEXT_PUBLIC_* credentials, arbitrary provider
# endpoint overrides, demo-mode switches, INGESTION_TOKEN or REDIS_URL variables.
